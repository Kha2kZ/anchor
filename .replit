modules = ["nodejs-20", "java-graalvm22.3", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Build"
mode = "sequential"
author = 49527460

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./anchor-macro/gradlew build"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk21", "gradle"]
